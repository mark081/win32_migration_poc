root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,cpp,h,ps1}]
indent_style = space
indent_size = 4

[*.{json,vcxproj,csproj,config}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
